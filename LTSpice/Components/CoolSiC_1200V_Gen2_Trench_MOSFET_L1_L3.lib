.FUNC N0FO1(N0FE7,N0FDD,N0FO5)={N0FO5-VGSTH(N0FE7,N0FDD,N0FO5)}
.FUNC VGSTH(N0FE7,N0FDD,N0FO5)={N0FOG+N0FQB*N0FMY(N0FQF*(N0FE7-25))-N0FQJ(N0FE7,N0FDD,N0FO5)+N0FHO }
.FUNC N0FQJ(N0FE7,N0FDD,N0FO5)={N0FQW*N0FDD+N0FQY*N0FNE(N0FR0*N0FDD)}
.FUNC N0FRJ(N0FE7,N0FDD,N0FO5)={((N0FO1(N0FE7,N0FDD,N0FO5)+0.00001+N0FSA*LOG(2*N0FNW(N0FO1(N0FE7,N0FDD,N0FO5)/N0FSA)))
+ )/2}
.FUNC N0FSE(N0FE7,N0FDD,N0FO5)={N0FHD*(N0FTP+N0FUK)*(ABS(N0FRJ(N0FE7,N0FDD,N0FO5))**(N0FUQ+N0FV4*N0FNE(ABS(N0FDD)
+ **N0FVJ)))}
.FUNC N0FVV(N0FE7,N0FDD,N0FO5)={1/((N0FTP+N0FUK)*ABS(N0FRJ(N0FE7,N0FDD,N0FO5))**N0FVW)}
