.FUNC N0FMY(N0FN8) {IF(N0FN8>=0,IF(N0FN8>50,(N0FN8-49)*EXP(50),EXP(N0FN8)),IF(ABS(N0FN8)>50,1/((ABS(N0FN8)-49)*EXP(50))
+ ,1/EXP(ABS(N0FN8))))}
.FUNC N0FNE(N0FN8) {(1-N0FMY(-2*N0FN8))/(1+N0FMY(-2*N0FN8))}
